<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="#F5F6FA" />
  </Style>
  <Style Selector="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="#18202D" />
    <Setter Property="Foreground" Value="#F5F6FA" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="22,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A3545" />
  </Style>
  <Style Selector="Button:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="Background" Value="#303B4A" />
  </Style>
  <Style Selector="Button.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#E8EDF4" />
    <Setter Property="Foreground" Value="#111722" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#F4F5F7" />
    <Setter Property="Foreground" Value="#101722" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#82CFFF" />
    <Setter Property="Foreground" Value="#101722" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="23" />
    <Setter Property="Padding" Value="20,13" />
  </Style>
  <Style Selector="Button.top">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="Padding" Value="20,10" />
  </Style>
  <Style Selector="Button.tile">
    <Setter Property="Padding" Value="5" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="#253143" />
  </Style>
  <Style Selector="Button.tile.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="Background" Value="#344459" />
  </Style>
  <Style Selector="Button.setting">
    <Setter Property="MinHeight" Value="91" />
    <Setter Property="Padding" Value="25,17" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#161E2B" />
  </Style>
  <Style Selector="Button.key">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinHeight" Value="55" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
