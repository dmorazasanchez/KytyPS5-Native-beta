#!/usr/bin/python3
"""Compare the latest full KDE and on-demand PS5 Minimal memory profiles."""
from pathlib import Path
import json
import sys
from collections import defaultdict

directory=Path("/var/log/ps5-ram-audit")
def latest(name):
    paths=sorted(directory.glob("*-"+name+".json"))
    if not paths:
        raise SystemExit(f"No {name} snapshot found in {directory}")
    return json.loads(paths[-1].read_text())

desktop=latest("desktop")
try:
    minimal=latest("ps5")
except SystemExit:
    print("KDE desktop baseline recorded. No PS5 Minimal sample yet.")
    print("Switch using your existing desktop icon 'PS5 Minimal Mode' and return to KDE.")
    print(f"Desktop sample: {desktop['captured_at']}")
    print(desktop["free_h"])
    raise SystemExit(0)

def v(x):
    return float(x["unavailable_gib"])
def group(data):
    out=defaultdict(float)
    for p in data["processes"]:
        out[p["name"]]+=p["pss_mib"]
    return out

print("               KDE desktop       PS5 Minimal         delta")
print(f"Measured:      {desktop['captured_at']}    {minimal['captured_at']}")
print(f"Non-available: {v(desktop):>8.3f} GiB       {v(minimal):>8.3f} GiB      {v(minimal)-v(desktop):>+7.3f} GiB")
print(f"Process PSS:   {desktop['process_total_pss_mib']:>8.1f} MiB       {minimal['process_total_pss_mib']:>8.1f} MiB      {minimal['process_total_pss_mib']-desktop['process_total_pss_mib']:>+7.1f} MiB")
print()
print("KDE free -h:\n",desktop["free_h"])
print("PS5 free -h:\n",minimal["free_h"])
print("\nPS5 process PSS (grouped by program):")
for k,val in sorted(group(minimal).items(),key=lambda e:e[1],reverse=True)[:25]:
    print(f" {val:8.1f} MiB {k}")
print("\nGPU allocations (MiB; not additive to system RAM):")
for k,v2 in minimal.get("gpu_mib",{}).items():
    print(f" {k}: {desktop.get('gpu_mib',{}).get(k,'n/a')} -> {v2}")
print("\nServices remaining in PS5 session:")
for line in minimal.get("system_services",[]):
    print(" ",line)
