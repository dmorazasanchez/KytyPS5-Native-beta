#!/usr/bin/env python3
"""Build a profile-derived, startup-only render plan, separate from the user's cheat file."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import struct
import sys


def generate(profile, preset, cache):
    spec = profile.get('runtime', {}).get('taa', {}).get('startup_render_presets')
    if preset == 'dynamic' or not spec:
        return None
    if spec.get('kind') != 'mode_render_pair_v1':
        raise ValueError('unsupported startup render-preset interface')
    size = spec.get('presets', {}).get(preset)
    if not isinstance(size, list) or len(size) != 2 or any(type(v) is not int for v in size):
        raise ValueError(f'render preset {preset!r} is unavailable for this executable')
    w, h = size
    if w < 640 or h < 360 or w > 3840 or h > 2160 or w * 9 != h * 16:
        raise ValueError('invalid render dimensions in profile')
    pair = spec['render_pair']
    writes = [dict(w) for w in spec['setup']]
    writes.append({'offset': pair['offset'], 'off': pair['off'], 'on': struct.pack('<II', w, h).hex()})
    for write in writes:
        offset = int(write['offset'], 16)
        before, after = bytes.fromhex(write['off']), bytes.fromhex(write['on'])
        if offset <= 0 or not before or len(before) != len(after) or not any(before):
            raise ValueError('invalid render-preset write in profile')
    game = profile['game']
    plan = {'id': game['title_id'], 'version': game['version'], 'process': 'eboot.bin',
            'mods': [{'name': f"{preset}: {w}x{h} render, 3840x2160 output", 'enabled': True, 'memory': writes}]}
    text = json.dumps(plan, indent=2) + '\n'
    digest = hashlib.sha256(text.encode()).hexdigest()[:16]
    cache = Path(cache)
    cache.mkdir(parents=True, exist_ok=True)
    output = cache / f"{game['sha256'][:12]}-{preset}-{digest}.json"
    if not output.exists() or output.read_text() != text:
        temporary = output.with_suffix(f'.{os.getpid()}.tmp')
        temporary.write_text(text)
        temporary.replace(output)
    return output.resolve()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--profile', required=True)
    parser.add_argument('--preset', required=True)
    parser.add_argument('--cache', default=str(Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) /
                                             'KytyPS5' / 'render-presets'))
    args = parser.parse_args()
    try:
        result = generate(json.loads(Path(args.profile).read_text()), args.preset, args.cache)
        if result:
            print(result)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'Render preset: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
