+bool CalibratedHlxFlags(uint32_t* flags) {
+	if (!Prof().taa_calibrate || g_cal_state.load(std::memory_order_acquire) != 2) return false;
+	*flags = 0x1u | (g_cal.depth_inverted ? 0x18u : 0u) | 0x20u | 0x40u;
+	return true;
