<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <reuseOutputMode>yes</reuseOutputMode>
    <adaptiveSync>fullscreen</adaptiveSync>
    <allowTearing>no</allowTearing>
    <xwaylandPersistence>no</xwaylandPersistence>
  </core>
  <theme><dropShadows>no</dropShadows></theme>
  <keyboard>
    <default />
    <keybind key="W-S-e">
      <action name="Execute" command="/usr/bin/pkexec /usr/local/libexec/ps5-minimal-control desktop" />
    </keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
</labwc_config>
